{
  "name": "gemini-translator",
  "version": "1.3.0",
  "description": "Gemini wire-format translator for the intisy-ai AI-proxy ecosystem.",
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "https://github.com/intisy-ai/gemini-translator.git"
  },
  "keywords": [
    "gemini",
    "ir",
    "canonical-ir",
    "translator",
    "ai",
    "intisy"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:teavm": "node node_modules/@intisy/bayonet/scripts/teavm-build.mjs --java-dir . --module :teavm-gemini --out src/generated/gemini-translator.teavm.js",
    "build": "npm run emit:teavm && npm run build:teavm && tsc && node build.mjs",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build",
    "emit:teavm": "node node_modules/@intisy/bayonet/scripts/emit-dts.mjs --java-dir . --module :teavm-gemini --out src/generated",
    "docs": "typedoc"
  },
  "dependencies": {
    "@intisy/bayonet": "^1.8.0",
    "@intisy-ai/basekit": "^4.0.0"
  },
  "devDependencies": {
    "@intisy/bayonet": "^1.8.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
